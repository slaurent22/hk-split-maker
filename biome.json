{
    "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": { "includes": ["**", "!!**/dist"] },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineEnding": "lf",
        "lineWidth": 80,
        "attributePosition": "auto",
        "bracketSameLine": false,
        "bracketSpacing": true,
        "expand": "auto",
        "useEditorconfig": true,
        "includes": [
            "**",
            "!**/node_modules/**",
            "!**/dist/**",
            "!**/.vscode/**",
            "!src/external-lib/**"
        ]
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    },
    "linter": {
        "enabled": true,
        "domains": {
            "react": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "a11y": {
                "noNoninteractiveElementInteractions": "error"
            },
            "nursery": {
                "noAccidentalBitwiseOperators": "error",
                "noArgumentsCallerOrCallee": "error",
                "noArrayDelete": "error",
                "noArrayForEach": "error",
                "noArrayMethodsOnArguments": "error",
                "noAsyncPromiseFinally": "error",
                "noAwaitInPromiseMethods": "error",
                "noBaseToString": "error",
                "noBooleanSortComparator": "error",
                "noBufferConstructor": "error",
                "noChainedComparison": "error",
                "noConstantComparisons": "error",
                "noDanglingUnderscore": "error",
                "noDoubleComparison": "error",
                "noDuplicateTypeConstituents": "error",
                "noEagerArrayMethodsInLoops": "error",
                "noExtendNative": "error",
                "noFloatingPromises": "error",
                "noImmediateMutation": "error",
                "noImpliedEval": "error",
                "noInvalidFileInputAccept": "error",
                "noInvalidThis": "error",
                "noLateCurrentTargetAccess": "error",
                "noLateEventControl": "error",
                "noMagicArrayFlatDepth": "error",
                "noMisleadingReturnType": "error",
                "noMismatchedMapKey": "error",
                "noMisplacedListElements": "error",
                "noMissingThrow": "error",
                "noMisusedPromises": "error",
                "noMisusedSpread": "error",
                "noNegatedArrayPredicate": "error",
                "noNegationInEqualityCheck": "error",
                "noNestedTemplateLiterals": "error",
                "noNewArray": "error",
                "noNonScalableViewport": "error",
                "noNumberArgumentOutOfRange": "error",
                "noObjectConstructor": "error",
                "noObsoleteAttributes": "error",
                "noObsoleteTags": "error",
                "noOctal": "error",
                "noPromiseExecutorReturn": "error",
                "noReactObjectTypeAsDefaultProp": "error",
                "noRedundantTypeConstituents": "error",
                "noReturnArrayPush": "error",
                "noReturnInFinally": "error",
                "noReturnInTest": "error",
                "noSelfImport": "error",
                "noSharedBranchCode": "error",
                "noSinglePromiseInPromiseMethods": "error",
                "noSubtractionComparison": "error",
                "noThisOutsideOfClass": "error",
                "noUndeclaredClasses": "error",
                "noUndeclaredCustomProperties": "error",
                "noUninvokedArrayCallback": "error",
                "noUnmodifiedLoopCondition": "error",
                "noUnnecessaryStringTrim": "error",
                "noUnreadableForOfExpression": "error",
                "noUnreadableIife": "error",
                "noUnsafePlusOperands": "error",
                "noUnsafeUnaryMinus": "error",
                "noUselessAssignment": "error",
                "noUselessAwait": "error",
                "noUselessDateGetTime": "error",
                "noUselessFallbackInSpread": "error",
                "noUselessLengthCheck": "error",
                "noUselessNestedTernary": "error",
                "noUselessParameterPropertyAssignment": "error",
                "noUselessQualifier": "error",
                "noUselessRecursion": "error",
                "noUselessSplice": "error",
                "noUselessSpread": "error",
                "noUselessTypeAssertion": "error",
                "noUselessTypeConversion": "error",
                "noXorAsExponentiation": "error",
                "noZeroFractions": "error",
                "useAccessorPairs": "error",
                "useAwaitThenable": "error",
                "useBetterDomTraversing": "error",
                "useBigintLiterals": "error",
                "useBlockStatementOverIife": "error",
                "useCapitalizedConstructors": "error",
                "useConsistentIndexedObjectStyle": "error",
                "useControlLabel": "error",
                "useEarlyContinue": "error",
                "useExhaustiveSwitchCases": "error",
                "useExpectEqualityMatcher": "error",
                "useExpectToStrictEqual": "error",
                "useExplicitReturnType": "error",
                "useExplicitType": "error",
                "useFlatMathMinMax": "error",
                "useGlobalRegexInMatchAll": "error",
                "useIncludes": "error",
                "useIteratorZip": "error",
                "useLowercaseTestTitle": "error",
                "useMatchingFunctionName": "error",
                "useMathAbs": "error",
                "useMathTrunc": "error",
                "useModernMathApis": "error",
                "useNamedFunction": "error",
                "useNullishCoalescing": "error",
                "useObjectFromEntries": "error",
                "usePromiseRejectErrors": "error",
                "useReactCompiler": "off",
                "useReactFunctionComponentDefinition": "error",
                "useReactNamingConvention": "error",
                "useRegexpExec": "error",
                "useSetSize": "error",
                "useSimplifiedBooleanReturn": "error",
                "useStringStartsEndsWith": "error",
                "useTopLevelDescribe": "error",
                "useUnaryMinus": "error",
                "useValidCharacterComparison": "error",
                "useValidTestTitle": "error",
                "useWhileLoopCondition": "error"
            },
            "complexity": {
                "noAdjacentSpacesInRegex": "error",
                "noBannedTypes": "error",
                "noDivRegex": "error",
                "noExcessiveCognitiveComplexity": {
                    "level": "error",
                    "options": {
                        "maxAllowedComplexity": 50
                    }
                },
                "noExcessiveNestedCallbacks": "error",
                "noExcessiveNestedTestSuites": "error",
                "noExtraBooleanCast": "error",
                "noForEach": "error",
                "noImplicitCoercions": "error",
                "noRedundantDefaultExport": "error",
                "noUnnecessaryTemplateExpression": "error",
                "noUselessCatch": "error",
                "noUselessCatchBinding": "error",
                "noUselessEscapeInRegex": "error",
                "noUselessLoneBlockStatements": "error",
                "noUselessReturn": "error",
                "noUselessStringConcat": "error",
                "noUselessThisAlias": "error",
                "noUselessTypeConstraint": "error",
                "noUselessUndefined": "error",
                "noUselessUndefinedInitialization": "error",
                "noVoid": "error",
                "useArrayFind": "error",
                "useArraySome": "error",
                "useMaxParams": "error",
                "useRegexpTest": "error",
                "useSimplifiedLogicExpression": "error",
                "useWhile": "error"
            },
            "correctness": {
                "noGlobalDirnameFilename": "error",
                "noNestedComponentDefinitions": "error",
                "noReactPropAssignments": "error",
                "noUndeclaredVariables": "error",
                "noUnusedInstantiation": "error",
                "noUnusedImports": "error",
                "noUnusedLabels": "error",
                "noUnusedVariables": {
                    "level": "error",
                    "options": { "ignoreRestSiblings": false }
                },
                "useParseIntRadix": "error",
                "useSingleJsDocAsterisk": "error"
            },
            "performance": {
                "noAwaitInLoops": "error",
                "noBarrelFile": "error",
                "noJsxPropsBind": "error",
                "noNamespaceImport": "error",
                "noReExportAll": "error",
                "noSyncScripts": "error",
                "useTopLevelRegex": "error"
            },
            "style": {
                "noCommonJs": "error",
                "noDescendingSpecificity": "error",
                "noNamespace": "error",
                "noNestedTernary": "error",
                "noParameterAssign": "error",
                "noYodaExpression": "error",
                "useArrayLiterals": "error",
                "useAsConstAssertion": "error",
                "useBlockStatements": "error",
                "useConsistentBuiltinInstantiation": "error",
                "useConsistentMemberAccessibility": "error",
                "useConsistentTypeDefinitions": "error",
                "useConst": "error",
                "useDefaultParameterLast": "error",
                "useDefaultSwitchClause": "error",
                "useGroupedAccessorPairs": "error",
                "useImportType": {
                    "level": "error",
                    "options": {
                        "style": "separatedType"
                    }
                },
                "useThrowOnlyError": "error"
            },
            "suspicious": {
                "noCatchAssign": "error",
                "noConfusingLabels": "error",
                "noDuplicateEnumValues": "error",
                "noDuplicateSelectors": "error",
                "noEmptyBlock": "error",
                "noEmptyBlockStatements": "error",
                "noEmptySource": "error",
                "noExplicitAny": "error",
                "noExtraNonNullAssertion": "error",
                "noForIn": "error",
                "noIrregularWhitespace": "error",
                "noLoopFunc": "error",
                "noPrototypeBuiltins": "error",
                "noReactStringRefs": "error",
                "noReturnAssign": "error",
                "noShadow": "error",
                "noTsIgnore": "error",
                "noUnknownAttribute": "error",
                "noUnusedExpressions": "error",
                "noUselessRegexBackrefs": "error",
                "noVar": "error",
                "useAwait": "error",
                "useDefaultSwitchClauseLast": "error"
            }
        },
        "includes": [
            "**",
            "!**/node_modules/**",
            "!**/dist/**",
            "!**/.vscode/**",
            "!src/external-lib/**"
        ]
    },
    "javascript": {
        "formatter": {
            "jsxQuoteStyle": "double",
            "quoteProperties": "asNeeded",
            "trailingCommas": "all",
            "semicolons": "always",
            "arrowParentheses": "always",
            "bracketSameLine": false,
            "quoteStyle": "double",
            "attributePosition": "auto",
            "bracketSpacing": true
        },
        "jsxRuntime": "transparent"
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true,
            "indentScriptAndStyle": false,
            "selfCloseVoidElements": "always"
        }
    },
    "overrides": [
        {
            "includes": ["**/*.js"],
            "linter": {
                "rules": {
                    "style": {
                        "noCommonJs": "off"
                    }
                }
            }
        },
        {
            "includes": ["tests/**"],
            "javascript": {
                "globals": ["describe", "expect", "test", "it"]
            }
        }
    ],
    "assist": {
        "enabled": true,
        "actions": { "source": { "organizeImports": "on" } }
    }
}
