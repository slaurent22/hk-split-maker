{
    "name": "hk-split-maker",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "biome": "biome check --write",
        "biome-check": "biome check",
        "build": "vite build",
        "check-all": "npm run biome-check && npm run typecheck && npm run build && npm run test",
        "format": "biome check --write --linter-enabled=false",
        "format-check": "biome check --linter-enabled=false",
        "gen-files-hk": "node tools/gen-files-hk.js",
        "gen-files-ss": "node tools/gen-files-ss.js",
        "postinstall": "husky install",
        "lint": "biome check --formatter-enabled=false --assist-enabled=false",
        "lintfix": "biome check --write --formatter-enabled=false --assist-enabled=false",
        "serve": "vite",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest watch --ui",
        "test:watch": "vitest watch",
        "typecheck": "tsc -b"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,css,md,json,yml}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "dependencies": {
        "@monaco-editor/react": "^4.5.0",
        "@reduxjs/toolkit": "^2.9.0",
        "@xmldom/xmldom": "^0.9.12",
        "classnames": "^2.3.2",
        "file-saver": "^2.0.5",
        "json5": "^2.2.0",
        "jszip": "^3.10.2",
        "monaco-editor": "^0.26.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.18.4",
        "react-select": "^5.3.0",
        "react-sortablejs": "^6.1.4",
        "react-tabs": "^6.1.1",
        "react-tooltip": "^5.29.1",
        "sortablejs": "^1.15.7",
        "xml": "^1.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.9",
        "@types/file-saver": "^2.0.2",
        "@types/node": "^24.10.9",
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.3.7",
        "@types/react-tabs": "^2.3.4",
        "@types/sortablejs": "^1.15.9",
        "@types/xml": "^1.0.5",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.1",
        "@vitest/ui": "^5.1.2",
        "husky": "^7.0.4",
        "lint-staged": "^12.3.7",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vite-plugin-node-polyfills": "^0.28.0",
        "vitest": "^5.1.1"
    },
    "engines": {
        "node": ">=24.13.0"
    }
}
